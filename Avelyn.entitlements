<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow running JIT compiled code (necessary for Python) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    
    <!-- Allow unsigned executable memory (necessary for some PyInstaller components) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <!-- Disable library validation to allow loading of 3rd party dylibs (like from pip packages) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- Explicitly declare we need Accessibility for UI scripting/automation -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
